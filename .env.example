# PostgreSQL
POSTGRES_USER=cti
# Required. Set a strong, unique password.
POSTGRES_PASSWORD=
POSTGRES_DB=cti

# Redis
# Required. Set a strong password. Special characters (@, :, /) are safe — URL-escaped internally.
REDIS_PASSWORD=

# Security
FEED_ENCRYPTION_KEY=generate-a-fernet-key

# Authentication
# Initial admin user created on first boot if no users exist
# Set a strong password — leave empty to skip admin user seeding
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Required in production. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In development mode only, an empty value auto-generates a random secret (sessions lost on restart)
JWT_SECRET_KEY=
# Set to true when running behind a reverse proxy (e.g., nginx in docker-compose)
TRUST_PROXY_HEADERS=true

# CORS
# JSON array of allowed origins. Must include your frontend URL in production.
# Do not use "*" — specify exact origins.
# Default (development): ["http://localhost:5173", "http://localhost:8080"]
# CORS_ORIGINS=["https://cti.example.com"]

# Logging
LOG_LEVEL=INFO
ENVIRONMENT=production

# Instance / display (read-only in the UI; change here + restart)
INSTANCE_NAME=EmergentCTI
# Daily deletion of stale observables (including manual/allowlisted) and sources.
# Irreversible; 0 disables retention. Negative values are rejected.
OBSERVABLE_RETENTION_DAYS=180
# Daily deletion (03:30 UTC) of audit history older than this many days.
# Bounded 30..3650; cannot be disabled. Independent of OBSERVABLE_RETENTION_DAYS.
AUDIT_RETENTION_DAYS=365
DEFAULT_EXPORT_FORMAT=text
# Maximum report attachment upload size in bytes (default: 20 MiB)
REPORT_MAX_UPLOAD_BYTES=20971520

# Optional feed API keys (leave empty to skip)
ABUSEIPDB_API_KEY=
URLSCAN_API_KEY=
THREATFOX_API_KEY=
PHISHTANK_API_KEY=
